<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.hyd</groupId>
  <artifactId>h2omap</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>OMAP (On Memory Analyze Processing)</name>
  <description>In-memory columnar storage for H2, plugged in through org.h2.api.TableEngine</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>

    <!--
      Maven Central 上的最新发布版是 2.5.252。
      本地 h2/ 目录里的源码是 2.5.259-SNAPSHOT，骨架签名按那份源码写。
      要对着本地源码开发时，先在 h2/ 下执行 mvn install，
      再把这里改成 2.5.259-SNAPSHOT。
    -->
    <h2.version>2.5.252</h2.version>
    <junit.version>5.10.0</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
              <filters>
                <filter>
                  <artifact>com.h2database:h2</artifact>
                  <excludes>
                    <exclude>org/h2/command/query/Select.class</exclude>
                    <exclude>org/h2/command/query/Select$*.class</exclude>
                    <exclude>org/h2/expression/condition/Comparison.class</exclude>
                    <exclude>org/h2/expression/condition/Comparison$*.class</exclude>
                    <exclude>org/h2/expression/condition/ConditionInQuery.class</exclude>
                    <exclude>org/h2/expression/condition/ConditionInQuery$*.class</exclude>
                    <exclude>org/h2/engine/DbSettings.class</exclude>
                    <exclude>org/h2/engine/DbSettings$*.class</exclude>
                    <exclude>org/h2/schema/Schema.class</exclude>
                    <exclude>org/h2/schema/Schema$*.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
